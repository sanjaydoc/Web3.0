{
  "name": "@web3/node",
  "version": "0.1.0",
  "description": "The Web3.0 node: a thin kernel that loads pluggable modules (naming, registry, messaging, payments, guardrails, observability).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "keygen": "tsx src/keygen.ts",
    "reset-store": "tsx src/reset-store.ts",
    "demo:consensus": "tsx src/demo-consensus.ts",
    "demo:x402": "tsx src/demo-x402.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@web3/consensus": "workspace:*",
    "@web3/core": "workspace:*",
    "@web3/crypto": "workspace:*",
    "@web3/ledger": "workspace:*",
    "@web3/x402": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "mongodb": "^6.12.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13",
    "esbuild": "0.28.1",
    "@types/pg": "^8.11.10"
  }
}
