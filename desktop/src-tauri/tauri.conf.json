{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web3.0 Node",
  "version": "0.1.0",
  "identifier": "com.web3.acpnode",
  "build": {
    "frontendDist": "../../apps/dashboard/dist",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @web3/dashboard build"
  },
  "app": {
    "windows": [
      {
        "title": "Web3.0 Node · Web3.0",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "shortDescription": "Run a Web3.0 Web3.0 node with a one-click app.",
    "longDescription": "A native desktop shell for the Web3.0 node + dashboard — double-click to run a node and manage it in a window, no terminal."
  }
}
