# Web3.0 configuration. Copy this file to `.env` and fill in your values:
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows)
# The real `.env` is gitignored — never commit secrets. Shell-exported variables
# override anything set here.

# ── Node ──────────────────────────────────────────────────────────────────────
WEB3_HOST=127.0.0.1
WEB3_PORT=8787
WEB3_LOG_LEVEL=info

# Stable signing identity so the persisted ledger still verifies after a restart.
# Generate one with:  pnpm --filter @web3/node keygen
WEB3_NODE_SEED=

# ── Settlement (how payments settle value) ────────────────────────────────────
# internal  = the Web3.0 ledger is the source of truth (default; fully self-contained).
# simulated = mimic an on-chain stablecoin transfer (deterministic fake tx refs, no real chain).
# testnet   = build a REAL ERC-20 transfer against an EVM testnet RPC. The node never holds a
#             signing key, so it prepares the transfer but does NOT broadcast — going live with real
#             funds means adding a funded signer yourself. No real money is ever moved here.
WEB3_SETTLEMENT=internal
# WEB3_SETTLEMENT_NETWORK=base-sepolia
# WEB3_SETTLEMENT_RPC_URL=https://sepolia.base.org
# WEB3_SETTLEMENT_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # a testnet USDC contract
# WEB3_SETTLEMENT_DECIMALS=6
# WEB3_SETTLEMENT_EXPLORER=https://sepolia.basescan.org

# ── Distributed L1 consensus (proof-of-authority) ─────────────────────────────
# off = solo node (default). poa = join a proof-of-authority block chain: authorities take turns
# proposing ML-DSA-signed blocks that batch ledger entries, gossiped to peers until all agree.
WEB3_CONSENSUS=off
# WEB3_AUTHORITIES=<b64u pubkey A>,<b64u pubkey B>,<b64u pubkey C>   # ordered proposer set (incl. this node)
# WEB3_PEERS=http://127.0.0.1:8788,http://127.0.0.1:8789             # peer node base URLs to gossip with
# WEB3_BLOCK_MS=3000                                                 # how often to try proposing on your turn
# WEB3_SLOT_MS=6000                                                  # if the in-turn authority is silent this long, the next steps in (proposer-skip)
# Try it locally with three in-process nodes:  pnpm --filter @web3/node demo:consensus

# ── Operator incentives (how running a node earns aETH) ───────────────────────
# All default to 0 (off). Turn these on to reward node operators.
WEB3_FEE_BPS=0            # protocol fee per payment, in basis points (e.g. 250 = 2.5%), to the treasury
WEB3_BLOCK_REWARD=0       # aETH minted to this node's treasury for each block it proposes
WEB3_TREASURY=treasury    # the treasury account's handle (treasury@web3.0) that collects earnings

# ── Persistence (MongoDB Atlas) ───────────────────────────────────────────────
# Leave WEB3_MONGODB_URI empty to run in-memory (dev). Set it to persist across restarts.
# Get the string from Atlas → Connect → Drivers, and put your db user's password in it.
WEB3_MONGODB_URI=
WEB3_MONGODB_DB=web3

# If you hit "querySrv ECONNREFUSED" connecting to a mongodb+srv:// Atlas URI, force Node to use
# public DNS resolvers for the SRV lookup (fixes networks where the system resolver blocks it):
# WEB3_DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Faucet & guardrails ───────────────────────────────────────────────────────
WEB3_FAUCET=100000          # opening balance per account, in minor units (1,000.00 aETH)
WEB3_SPEND_CAP=500000       # max spend per window, minor units
WEB3_RATE_LIMIT=120         # max messages per window
WEB3_WINDOW_MS=60000        # guardrail window length (ms)

# ── Auth & rate-limit hardening ───────────────────────────────────────────────
# WEB3_AUTH_ENFORCE=true rejects bad signatures / replays / rate-limit breaches (recommended).
# Set it to false for "warn-only": violations are logged to the event feed but still allowed —
# handy while migrating older clients. Either way the decision is recorded.
WEB3_AUTH_ENFORCE=true
WEB3_AUTH_FRESHNESS_MS=120000   # max age of a signed envelope before it's rejected as stale
WEB3_AUTH_CLOCK_SKEW_MS=5000    # tolerance for envelopes dated slightly in the future
WEB3_HTTP_RATE_LIMIT=600        # max HTTP requests per client IP per window (0 disables)
WEB3_HTTP_RATE_WINDOW_MS=60000  # HTTP rate-limit window length (ms)

# ── Agent brains (used by your Python agents, not the node itself) ─────────────
# Local LLM via an OpenAI-compatible API (Ollama, LM Studio, vLLM, …). Use any model
# you've installed. LLM_FALLBACK_MODELS are tried in order if the primary errors or
# isn't pulled — so an agent keeps working with whatever model is available.
# NB: use 127.0.0.1, not localhost. On Windows "localhost" can resolve to IPv6 ::1,
# where Ollama (IPv4-only by default) isn't listening, and Python's urllib hangs on it.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODELS=qwen2.5:3b,qwen2.5-coder:7b
LLM_API_KEY=ollama

# Or use hosted Claude instead — get a key at https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Telegram front door (examples/telegram-bot) ───────────────────────────────
# A Telegram bot that bridges humans to Web3.0 agents. Create a bot with @BotFather and paste its
# token here. With NO token the bot runs in local MOCK mode (type commands at the prompt).
# TELEGRAM_BOT_TOKEN=
# WEB3_URL=http://127.0.0.1:8787
