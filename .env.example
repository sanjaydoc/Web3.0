# ACP configuration. Copy this file to `.env` and fill in your values:
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows)
# The real `.env` is gitignored — never commit secrets. Shell-exported variables
# override anything set here.

# ── Node ──────────────────────────────────────────────────────────────────────
ACP_HOST=127.0.0.1
ACP_PORT=8787
ACP_LOG_LEVEL=info

# Stable signing identity so the persisted ledger still verifies after a restart.
# Generate one with:  pnpm --filter @acp/node keygen
ACP_NODE_SEED=

# ── Settlement (how payments settle value) ────────────────────────────────────
# internal  = the ACP ledger is the source of truth (default; fully self-contained).
# simulated = mimic an on-chain stablecoin transfer (deterministic fake tx refs, no real chain).
# testnet   = build a REAL ERC-20 transfer against an EVM testnet RPC. The node never holds a
#             signing key, so it prepares the transfer but does NOT broadcast — going live with real
#             funds means adding a funded signer yourself. No real money is ever moved here.
ACP_SETTLEMENT=internal
# ACP_SETTLEMENT_NETWORK=base-sepolia
# ACP_SETTLEMENT_RPC_URL=https://sepolia.base.org
# ACP_SETTLEMENT_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # a testnet USDC contract
# ACP_SETTLEMENT_DECIMALS=6
# ACP_SETTLEMENT_EXPLORER=https://sepolia.basescan.org

# ── Distributed L1 consensus (proof-of-authority) ─────────────────────────────
# off = solo node (default). poa = join a proof-of-authority block chain: authorities take turns
# proposing ML-DSA-signed blocks that batch ledger entries, gossiped to peers until all agree.
ACP_CONSENSUS=off
# ACP_AUTHORITIES=<b64u pubkey A>,<b64u pubkey B>,<b64u pubkey C>   # ordered proposer set (incl. this node)
# ACP_PEERS=http://127.0.0.1:8788,http://127.0.0.1:8789             # peer node base URLs to gossip with
# ACP_BLOCK_MS=3000                                                 # how often to try proposing on your turn
# Try it locally with three in-process nodes:  pnpm --filter @acp/node demo:consensus

# ── Persistence (MongoDB Atlas) ───────────────────────────────────────────────
# Leave ACP_MONGODB_URI empty to run in-memory (dev). Set it to persist across restarts.
# Get the string from Atlas → Connect → Drivers, and put your db user's password in it.
ACP_MONGODB_URI=
ACP_MONGODB_DB=acp

# If you hit "querySrv ECONNREFUSED" connecting to a mongodb+srv:// Atlas URI, force Node to use
# public DNS resolvers for the SRV lookup (fixes networks where the system resolver blocks it):
# ACP_DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Faucet & guardrails ───────────────────────────────────────────────────────
ACP_FAUCET=100000          # opening balance per account, in minor units (1,000.00 aUSD)
ACP_SPEND_CAP=500000       # max spend per window, minor units
ACP_RATE_LIMIT=120         # max messages per window
ACP_WINDOW_MS=60000        # guardrail window length (ms)

# ── Auth & rate-limit hardening ───────────────────────────────────────────────
# ACP_AUTH_ENFORCE=true rejects bad signatures / replays / rate-limit breaches (recommended).
# Set it to false for "warn-only": violations are logged to the event feed but still allowed —
# handy while migrating older clients. Either way the decision is recorded.
ACP_AUTH_ENFORCE=true
ACP_AUTH_FRESHNESS_MS=120000   # max age of a signed envelope before it's rejected as stale
ACP_AUTH_CLOCK_SKEW_MS=5000    # tolerance for envelopes dated slightly in the future
ACP_HTTP_RATE_LIMIT=600        # max HTTP requests per client IP per window (0 disables)
ACP_HTTP_RATE_WINDOW_MS=60000  # HTTP rate-limit window length (ms)

# ── Agent brains (used by your Python agents, not the node itself) ─────────────
# Local LLM via an OpenAI-compatible API (Ollama, LM Studio, vLLM, …). Use any model
# you've installed. LLM_FALLBACK_MODELS are tried in order if the primary errors or
# isn't pulled — so an agent keeps working with whatever model is available.
# NB: use 127.0.0.1, not localhost. On Windows "localhost" can resolve to IPv6 ::1,
# where Ollama (IPv4-only by default) isn't listening, and Python's urllib hangs on it.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODELS=qwen2.5:3b,qwen2.5-coder:7b
LLM_API_KEY=ollama

# Or use hosted Claude instead — get a key at https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
